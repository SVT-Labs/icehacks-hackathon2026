# Copy this file to .env.local and fill in the values. Never commit .env.local.
#
# With nothing set, the app runs in demo mode: the whole game runs inside the
# browser and no server, database or AI key is needed.

# ---------- Browser (public: these are sent to every visitor) ----------

# Firebase Realtime Database, read-only for browsers. Setting the database URL
# switches the app from demo mode to the live backend.
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Set to 1 to force demo mode even when Firebase is configured.
NEXT_PUBLIC_MOCK=

# ---------- Server (secret: never prefix these with NEXT_PUBLIC_) ----------

# Firebase service account, used by the API routes to read and write rooms.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes; line breaks in the key are written as \n.
FIREBASE_PRIVATE_KEY=""
FIREBASE_DATABASE_URL=

# Anthropic API key for the AI-written lies. Without it (or with DEMO_MODE=true)
# players get canned lies or write their own, and the game still works.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# true = never call the AI; answer with canned lies after validating the input.
DEMO_MODE=false

# Most AI calls allowed per day across all rooms. Beyond it, players write
# their own lies until the next day.
LLM_DAILY_CAP=1500
